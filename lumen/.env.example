# Lumen Environment Variables
# Copy this file to .env and fill in your API keys
# NEVER commit .env to version control

# =============================================================================
# Market Data Providers
# =============================================================================

# Alpha Vantage API Key (free tier: 5 calls/minute, 500 calls/day)
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Yahoo Finance (no API key required for basic usage)
# YAHOO_FINANCE_ENABLED=true

# =============================================================================
# Quantum Computing Providers (Optional - Premium/Enterprise)
# =============================================================================

# D-Wave Leap API Key
# Get your key at: https://cloud.dwavesys.com/leap/
# Required for quantum annealing (QUBO) solving
DWAVE_API_KEY=your_dwave_api_key_here

# D-Wave Solver Selection (optional, uses hybrid by default)
# Options: hybrid_binary_quadratic_model_version2, Advantage_system6.1
# DWAVE_SOLVER=hybrid_binary_quadratic_model_version2

# IBM Quantum API Key
# Get your key at: https://quantum-computing.ibm.com/
# Required for gate-based quantum (QAOA) solving
IBM_QUANTUM_API_KEY=your_ibm_quantum_api_key_here

# IBM Quantum Backend (optional)
# Options: ibmq_qasm_simulator, ibm_nairobi, ibm_oslo, etc.
# IBM_QUANTUM_BACKEND=ibmq_qasm_simulator

# IonQ API Key (future support)
# IONQ_API_KEY=your_ionq_api_key_here

# =============================================================================
# Application Settings
# =============================================================================

# Lumen Home Directory (default: ~/.lumen)
# LUMEN_HOME=/path/to/custom/home

# Log Level: TRACE, DEBUG, INFO, WARN, ERROR, FATAL
# LUMEN_LOG_LEVEL=INFO

# Enable PyFlare Telemetry (default: false, opt-in only)
# LUMEN_PYFLARE_ENABLED=false

# =============================================================================
# Security Settings
# =============================================================================

# HTTP Server API Key (required for server authentication)
# Generate a strong random key: openssl rand -hex 32
# LUMEN_API_KEY=your_secure_api_key_here

# Database Encryption Key (requires SQLCipher to be installed)
# Generate a strong random key: openssl rand -hex 32
# LUMEN_DB_KEY=your_database_encryption_key_here

# =============================================================================
# Development / Testing
# =============================================================================

# Skip quantum API calls in tests
# LUMEN_SKIP_QUANTUM_TESTS=true

# Use mock market data in tests
# LUMEN_USE_MOCK_MARKET_DATA=true

# Database path override (useful for testing)
# LUMEN_DB_PATH=/tmp/lumen_test.db
